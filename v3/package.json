{
  "name": "brew-and-speak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:dev": "tsx server/index.ts",
    "api:flow:test": "node --import tsx --test server/homeworkFlow.test.ts",
    "app:api:test": "node --import tsx --test src/api/productApi.test.ts src/api/telegramInitData.test.ts",
    "models:prepare": "tsx scripts/prepare-poses.ts",
    "models:audit": "tsx scripts/audit-poses.ts",
    "api:test": "node scripts/run-tests.mjs server",
    "api:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "api:production:test": "node --import tsx --test server/createProductionApp.test.ts server/productionEntrypoint.test.ts",
    "legacy:inventory": "tsx server/scripts/legacyInventory.ts",
    "legacy:api-audit": "tsx server/scripts/auditLegacyApi.ts",
    "legacy:snapshot": "tsx server/scripts/legacySnapshot.ts",
    "sandbox:attempt-rehearsal": "tsx server/scripts/sandboxAttemptRehearsal.ts",
    "sandbox:migrate": "tsx server/scripts/sandboxMigrate.ts",
    "production:migrate": "tsx server/scripts/productionMigrate.ts",
    "security:scan": "tsx server/scripts/secretScan.ts",
    "app:unit:test": "node scripts/run-tests.mjs src",
    "app:domain:test": "npm run app:unit:test",
    "app:e2e": "playwright test",
    "app:e2e:production": "playwright test --config playwright.production.config.ts",
    "app:e2e:production:report": "playwright show-report node_modules/.cache/production-e2e/report",
    "app:e2e:report": "playwright show-report",
    "app:release-check": "npm run app:unit:test && npm run app:e2e && npm run app:e2e:production && npm run models:audit && npm run api:release-check",
    "api:release-check": "npm run security:scan && npm run api:test && npm run api:typecheck && npm run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@react-three/fiber": "^8.18.0",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "2.17.7",
    "three": "^0.181.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "~5.6.2",
    "vite": "^6.0.0"
  },
  "overrides": {
    "sanitize-html": {
      "htmlparser2": "8.0.2"
    }
  }
}
